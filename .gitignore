# dependencies
node_modules/

# build output
lib/
# …but scripts/lib is source: the `lib/` rule above matches every directory
# named lib, so without this the holiday-span helper stays untracked and CI
# cannot import it.
!/scripts/lib/

# generator snapshot cache (scripts/gen-prices.mjs --offline)
.cache/

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# editor
.idea/
.vscode/

# packaged tarballs (npm pack)
*.tgz

# 私有文档（公开文档在 docs/）：只跟踪入口 README，内容留在本机
docs-private/*
!docs-private/README.md
