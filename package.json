{
  "name": "dsh-plugin-usage",
  "description": "Token 用量统计：按天/自定义范围查看 Token、调用次数与参考成本，支持模型筛选、定价匹配与年度热力图 · Token usage statistics for DeepSeek Harness",
  "version": "0.6.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennett-dsh/dsh-plugin-usage.git"
  },
  "homepage": "https://github.com/bennett-dsh/dsh-plugin-usage",
  "bugs": {
    "url": "https://github.com/bennett-dsh/dsh-plugin-usage/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/host/index.js",
  "exports": {
    ".": {
      "default": "./lib/host/index.js"
    },
    "./client": {
      "default": "./lib/client/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "!lib/client/*.map",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "image.png",
    "image-1.png",
    "screenshots.json",
    "README.en.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "harness",
    "plugin",
    "usage",
    "token",
    "statistics",
    "cost"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "verifiedAgainst": "0.2.2-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-client.js",
    "test": "node --test tests/*.test.js tests/*.test.cjs && node tools/check-docs.mjs",
    "prices": "node scripts/gen-prices.mjs",
    "watch": "tsc -p tsconfig.json --watch",
    "check:docs": "node tools/check-docs.mjs",
    "prepublishOnly": "npm run build && npm test && npm run verify:typert && npm run verify:remote",
    "pretest": "npm run build",
    "verify:typert": "node scripts/verify-typert.mjs",
    "verify:remote": "node scripts/verify-remote-channel.mjs"
  }
}
